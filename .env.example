# Inquiry form delivery (Resend). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Spletne <info@spletne.com>". For quick tests: onboarding@resend.dev.
LEAD_FROM=
# Where inquiries are delivered.
LEAD_INBOX=

# Preview access codes: where the admin app lives and the key it expects from this site.
CONTROL_PLANE_URL=https://app.spletne.com
MARKETING_API_KEY=
# Optional. Defaults: spletne.com / https. Only override for local testing.
PREVIEW_ROOT_DOMAIN=
PREVIEW_SCHEME=
