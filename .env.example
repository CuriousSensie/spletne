# Contact form delivery (SMTP). Set these in Vercel → Project → Settings → Environment Variables.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an app password (needs 2-step verification).
# Zoho EU: SMTP_HOST=smtp.zoho.eu, SMTP_PORT=465.
SMTP_HOST=
SMTP_PORT=465
# "true" for port 465 (TLS), "false" for 587 (STARTTLS). Defaults from the port when unset.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender address (usually the same mailbox as SMTP_USER).
LEAD_FROM=
# Where preview requests are delivered.
LEAD_INBOX=

# Preview access codes: where the admin app lives and the key it expects from this site.
CONTROL_PLANE_URL=https://app.spletne.com
MARKETING_API_KEY=
# Optional. Defaults: spletne.com / https. Only override for local testing.
PREVIEW_ROOT_DOMAIN=
PREVIEW_SCHEME=
